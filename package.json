{
  "name": "image-craft-service",
  "version": "1.2.1",
  "description": "Self-hosted image processing HTTP API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/client"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:dashboard",
    "build:dashboard": "tsc -p tsconfig.dashboard.json && cp dashboard/index.html dashboard/styles.css dashboard/dist/",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p packages/client/tsconfig.json --noEmit",
    "test": "npm run build:dashboard && vitest run",
    "test:watch": "vitest",
    "sign": "tsx scripts/sign.ts",
    "openapi:generate": "tsx scripts/export-openapi.ts",
    "openapi:types": "openapi-typescript openapi/openapi.json -o packages/client/src/generated.ts && prettier --write packages/client/src/generated.ts",
    "sdk:generate": "npm run openapi:generate && npm run openapi:types && python3 scripts/generate-python-sdk.py",
    "client:build": "npm run openapi:types && npm run build --prefix packages/client",
    "sdk:contract": "vitest run test/sdk-contract.test.ts",
    "benchmark:profile": "tsx scripts/profile-transform.ts",
    "benchmark:smart-quality": "tsx scripts/benchmark-smart-quality.ts",
    "load:scale": "node scripts/load-test-scale.mjs",
    "benchmark:fixture": "node scripts/generate-benchmark-fixture.mjs",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepack": "rm -rf dist && npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/otel": "^0.21.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "archiver": "^8.0.0",
    "blurhash": "^2.0.5",
    "bullmq": "^6.3.11",
    "exif-reader": "^2.0.3",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.2.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.13.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "openapi-typescript": "^7.13.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.5.3",
    "react": "^19.3.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "main": "./dist/server.js",
  "bin": {
    "image-craft-service": "dist/server.js"
  },
  "files": [
    "dist/**",
    "dashboard/dist/**",
    "README.md",
    "docs/plugins.md",
    "src/plugins/README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "overrides": {
    "vite": "^6.4.3",
    "esbuild": "^0.25.12"
  }
}
